---
---

<header class="d-flex flex-wrap justify-content-between align-items-center pb-3 mb-4 border-bottom border-secondary border-opacity-25 gap-3">
  <div>
    <h1 class="h4 mb-1 d-flex align-items-center gap-2">
      <i class="fa fa-qrcode text-primary" aria-hidden="true"></i>
      <span>QRImage Generator</span>
      <span id="header-scan-badge" class="badge badge-scannable text-xs fw-semibold px-2 py-1 ms-2" style="font-size: 0.72rem;">
        <i class="fa fa-shield me-1"></i>Guaranteed Scan ON
      </span>
    </h1>
    <p class="text-secondary small mb-0">High-contrast, scannable QR codes with guaranteed camera detection and full styling control.</p>
  </div>
  <div class="d-flex align-items-center gap-2">
    <button type="button" class="btn btn-outline-secondary btn-sm" id="btn-reset" title="Reset all options to default">
      <i class="fa fa-undo me-1" aria-hidden="true"></i>
      Reset Options
    </button>
  </div>
</header>
