---
---

<div class="qr-sticky-pane">
  <div class="card overflow-hidden">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center py-2 px-3 gap-2">
      <span class="small fw-bold text-white d-flex align-items-center">
        <i class="fa fa-eye text-primary me-1" aria-hidden="true"></i>
        Live Viewport
      </span>
      <div class="d-flex align-items-center gap-2">
        <select id="export-size-select" class="form-select form-select-sm py-1 px-2 text-white bg-dark border-secondary" style="width: auto; font-size: 0.8rem;" title="Export PNG Resolution">
          <option value="512">512 px</option>
          <option value="1024" selected>1024 px</option>
          <option value="2048">2048 px (2K)</option>
          <option value="4096">4096 px (4K)</option>
        </select>
        <button type="button" class="btn btn-sm btn-outline-light fw-medium" id="btn-copy"
          title="Copy to Clipboard">
          <i class="fa fa-copy me-1" aria-hidden="true"></i>
          <span id="copy-btn-text">Copy</span>
        </button>
        <button type="button" class="btn btn-sm btn-primary fw-semibold" id="btn-download"
          title="Download PNG at chosen resolution">
          <i class="fa fa-download me-1" aria-hidden="true"></i>
          Download
        </button>
      </div>
    </div>

    <div class="qr-preview-area position-relative">
      <div id="preview-placeholder" class="text-center text-muted p-4">
        <i class="fa fa-qrcode fa-3x d-block opacity-25 mb-2" aria-hidden="true"></i>
        <span class="small">Enter a URL/payload and click Generate</span>
      </div>
      <div id="qrcode" class="qr-output-box d-none"></div>
    </div>

    <div id="card-footer-target" class="card-footer py-2 px-3 small text-truncate">
      <div class="d-flex justify-content-between align-items-center">
        <span class="text-muted me-1">Payload:</span>
        <code class="user-select-all text-truncate" id="target-display"></code>
      </div>
    </div>
  </div>
</div>
