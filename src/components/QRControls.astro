---
---

<div class="d-flex flex-column gap-3">

  <!-- 1. URL / Content Input -->
  <section class="card p-3" aria-label="Payload Input">
    <label for="qr-url" class="form-label small fw-semibold text-white mb-2">URL or Payload Content</label>
    <div class="input-group">
      <input id="qr-url" class="form-control" type="text" placeholder="https://example.com"
        value="https://github.com/ryguy0601/qr_image" autocomplete="off" spellcheck="false" />
      <button class="btn btn-outline-secondary px-3 text-muted" type="button" id="btn-clear-url" title="Clear input">
        <i class="fa fa-times" aria-hidden="true"></i>
      </button>
      <button class="btn btn-primary px-3 fw-semibold" type="button" id="btn-generate">
        <i class="fa fa-bolt me-1" aria-hidden="true"></i>
        Generate
      </button>
    </div>
    <div id="error-alert" class="alert alert-danger small mt-2 mb-0 py-2 d-none" role="alert">
      <i class="fa fa-exclamation-triangle me-1" aria-hidden="true"></i>
      <span id="error-message"></span>
    </div>
  </section>

  <!-- 2. GUARANTEED SCAN TOGGLE CARD -->
  <section class="card p-3"
    style="border-color: rgba(99, 102, 241, 0.4) !important; background: linear-gradient(135deg, rgba(19, 27, 46, 0.95), rgba(30, 41, 59, 0.95));"
    aria-label="Scan Protection Mode">
    <div class="d-flex justify-content-between align-items-center">
      <div>
        <div class="d-flex align-items-center gap-2">
          <i class="fa fa-shield text-success fs-5" id="scan-shield-icon"></i>
          <span class="fw-bold fs-6 text-white">Guaranteed Scan Mode</span>
          <span id="scan-status-badge" class="badge badge-scannable ms-1">Protected (Safe Bounds)</span>
        </div>
        <p class="small text-muted mb-0 mt-1" id="scan-status-desc">
          Guarantees camera scannability with solid white portions and safe module sizing. Turn OFF for
          complete custom freedom to set any numbers.
        </p>
      </div>
      <div class="form-check form-switch fs-4 mb-0 ms-3">
        <input id="toggle-guaranteed-scan" type="checkbox" class="form-check-input cursor-pointer" checked
          aria-label="Toggle guaranteed scan mode" />
      </div>
    </div>
  </section>

  <!-- 3. Embedded Image / Artwork -->
  <section class="card p-3" aria-label="Image Embedding">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-2 gap-2">
      <span class="small fw-semibold text-white">
        <i class="fa fa-picture-o text-primary me-1" aria-hidden="true"></i>
        Embedded Image / Artwork
      </span>
      <span class="text-secondary small">PNG, JPG, SVG, WebP (&lt;10 MB)</span>
    </div>

    <!-- Dropzone Empty State -->
    <div id="dropzone-empty" class="qr-dropzone">
      <input id="qr-image" type="file"
        class="position-absolute top-0 start-0 w-100 h-100 opacity-0 cursor-pointer" style="z-index: 5;"
        accept="image/*" aria-label="Upload embedded image" />
      <div class="d-flex flex-column align-items-center text-center" style="pointer-events: none;">
        <i id="drop-icon" class="fa fa-cloud-upload fa-2x mb-2 text-primary" aria-hidden="true"></i>
        <span id="drop-text" class="small text-white fw-semibold">Click or drag &amp; drop an image here</span>
        <span class="small text-secondary mt-1">Or paste from clipboard using <kbd class="px-1 py-0 bg-dark text-light border border-secondary rounded">Ctrl+V</kbd></span>
      </div>
    </div>

    <!-- File Selected State -->
    <div id="file-selected-box"
      class="d-flex justify-content-between align-items-center p-2 rounded border border-secondary border-opacity-25 bg-dark bg-opacity-50 d-none">
      <div class="d-flex align-items-center gap-2 text-truncate me-2">
        <img id="image-preview-thumb" src="" alt="Thumbnail" class="rounded"
          style="width: 38px; height: 38px; object-fit: cover;" />
        <span class="small text-truncate text-white fw-medium" id="image-name-display">
          <span id="image-name-text"></span>
        </span>
      </div>
      <div class="btn-group btn-group-sm">
        <label for="qr-image-replace" class="btn btn-outline-secondary cursor-pointer mb-0" title="Replace Image">
          <i class="fa fa-pencil" aria-hidden="true"></i>
        </label>
        <input id="qr-image-replace" type="file" class="d-none" accept="image/*" />
        <button type="button" class="btn btn-outline-danger" title="Remove Image" id="btn-clear-image">
          <i class="fa fa-times" aria-hidden="true"></i>
        </button>
      </div>
    </div>

    <!-- Image Embedding Mode & Controls -->
    <div id="image-options-panel"
      class="row g-3 mt-2 pt-2 border-top border-secondary border-opacity-25 d-none">
      <div class="col-12">
        <label class="form-label small text-white mb-1">Embedding Style</label>
        <div class="btn-group btn-group-sm w-100" role="group">
          <input type="radio" class="btn-check" name="imageModeRadio" id="mode-background" value="background"
            checked />
          <label class="btn btn-outline-secondary fw-medium" for="mode-background">
            <i class="fa fa-th-large me-1"></i> Background Art
          </label>

          <input type="radio" class="btn-check" name="imageModeRadio" id="mode-center" value="center" />
          <label class="btn btn-outline-secondary fw-medium" for="mode-center">
            <i class="fa fa-dot-circle-o me-1"></i> Center Logo
          </label>
        </div>
      </div>

      <div class="col-sm-6" id="tint-control-container">
        <div class="d-flex justify-content-between small text-white mb-1">
          <label for="opt-opacity">Background Dimming / Tint</label>
          <code id="val-opacity">0%</code>
        </div>
        <input id="opt-opacity" type="range" class="form-range" min="0" max="70" step="5" value="0" />
      </div>

      <div class="col-sm-6">
        <div class="d-flex justify-content-between align-items-center small text-white mb-1">
          <label for="opt-image-margin" class="mb-0">Image Inset Margin</label>
          <div class="d-flex align-items-center gap-1">
            <input type="number" id="num-image-margin" class="num-input-box" min="0" max="10" value="0" />
            <span class="text-white small fw-bold">mod</span>
          </div>
        </div>
        <input id="opt-image-margin" type="range" class="form-range" min="0" max="10" step="1" value="0" />
      </div>
    </div>
  </section>

  <!-- 4. Module Sizing, White Portion & Border Width Controls -->
  <section class="card p-3" aria-label="Module & Border Sizing">
    <div
      class="small fw-semibold text-white mb-3 pb-2 border-bottom border-secondary border-opacity-25 d-flex justify-content-between align-items-center">
      <span>
        <i class="fa fa-sliders me-1 text-primary" aria-hidden="true"></i>
        Module Sizing, White Portion &amp; Borders
      </span>
      <span id="range-bound-hint" class="text-secondary small fw-normal">Safe Mode: 60% – 100%</span>
    </div>

    <div class="row g-3">
      <!-- Dark Module Scale with Slider and Number Input -->
      <div class="col-sm-6">
        <div class="d-flex justify-content-between align-items-center small text-white mb-1">
          <label for="opt-dot" class="mb-0">Dark Module Scale</label>
          <div class="d-flex align-items-center gap-1">
            <input type="number" id="num-dot" class="num-input-box" min="60" max="100" value="100" />
            <span class="text-white small fw-bold">%</span>
          </div>
        </div>
        <input id="opt-dot" type="range" class="form-range" min="60" max="100" step="1" value="100" />
        <small class="text-secondary d-block mt-1" style="font-size: 0.74rem;">Size of dark code modules.</small>
      </div>

      <!-- White Portion Scale with Slider and Number Input -->
      <div class="col-sm-6">
        <div class="d-flex justify-content-between align-items-center small text-white mb-1">
          <label for="opt-white-size" class="mb-0">White Portion Fill</label>
          <div class="d-flex align-items-center gap-1">
            <input type="number" id="num-white-size" class="num-input-box" min="60" max="100" value="100" />
            <span class="text-white small fw-bold">%</span>
          </div>
        </div>
        <input id="opt-white-size" type="range" class="form-range" min="60" max="100" step="1" value="100" />
        <small class="text-secondary d-block mt-1" style="font-size: 0.74rem;">Coverage of pure white light modules.</small>
      </div>

      <!-- Border Width Slider & Number Input -->
      <div class="col-sm-6">
        <div class="d-flex justify-content-between align-items-center small text-white mb-1">
          <label for="opt-border" class="mb-0">Border Width (Quiet Zone)</label>
          <div class="d-flex align-items-center gap-1">
            <input type="number" id="num-border" class="num-input-box" min="1" max="15" value="4" />
            <span class="text-white small fw-bold">mod</span>
          </div>
        </div>
        <input id="opt-border" type="range" class="form-range" min="1" max="15" step="1" value="4" />
        <small class="text-secondary d-block mt-1" style="font-size: 0.74rem;">Outer quiet zone padding (0 to 15 modules).</small>
      </div>

      <!-- Corner Eye Roundness with Slider and Number Input -->
      <div class="col-sm-6">
        <div class="d-flex justify-content-between align-items-center small text-white mb-1">
          <label for="opt-finder-round" class="mb-0">Corner Eye Roundness</label>
          <div class="d-flex align-items-center gap-1">
            <input type="number" id="num-finder-round" class="num-input-box" min="0" max="100" value="100" />
            <span class="text-white small fw-bold">%</span>
          </div>
        </div>
        <input id="opt-finder-round" type="range" class="form-range" min="0" max="100" step="1" value="100" />
        <small class="text-secondary d-block mt-1" style="font-size: 0.74rem;">Curvature of the 3 corner finder markers.</small>
      </div>

      <!-- Module Curvature with Slider and Number Input -->
      <div class="col-sm-6">
        <div class="d-flex justify-content-between align-items-center small text-white mb-1">
          <label for="opt-round" class="mb-0">Module Curvature</label>
          <div class="d-flex align-items-center gap-1">
            <input type="number" id="num-round" class="num-input-box" min="0" max="100" value="0" />
            <span class="text-white small fw-bold">%</span>
          </div>
        </div>
        <input id="opt-round" type="range" class="form-range" min="0" max="100" step="1" value="0" />
        <small class="text-secondary d-block mt-1" style="font-size: 0.74rem;">Smooths data module corners.</small>
      </div>

      <div class="col-12 pt-1">
        <div class="form-check form-switch small">
          <input id="opt-white-dots" type="checkbox" class="form-check-input cursor-pointer" checked />
          <label for="opt-white-dots" class="form-check-label text-white cursor-pointer fw-semibold">
            Draw White Modules &amp; Corner Separators
          </label>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Colors & Background -->
  <section class="card p-3" aria-label="Colors & Contrast">
    <div class="small fw-semibold text-white mb-3 pb-2 border-bottom border-secondary border-opacity-25">
      <i class="fa fa-paint-brush me-1 text-primary" aria-hidden="true"></i>
      Colors &amp; Contrast
    </div>

    <div class="d-flex flex-wrap align-items-center gap-3">
      <label class="d-inline-flex align-items-center gap-2 small mb-0 cursor-pointer">
        <input type="color" class="form-control form-control-color" id="opt-fg" value="#000000" />
        <span class="text-white">Code Color</span>
        <code id="lbl-fg">#000000</code>
      </label>

      <label id="lbl-bg-container" class="d-inline-flex align-items-center gap-2 small mb-0 cursor-pointer">
        <input type="color" class="form-control form-control-color" id="opt-bg" value="#ffffff" />
        <span class="text-white">Background</span>
        <code id="lbl-bg">#ffffff</code>
      </label>

      <div class="form-check form-switch small mb-0 ms-auto">
        <input id="opt-trans" type="checkbox" class="form-check-input cursor-pointer" />
        <label for="opt-trans" class="form-check-label text-muted cursor-pointer">Transparent Outer Canvas</label>
      </div>
    </div>

    <div id="contrast-warning" class="alert alert-warning small mt-3 mb-0 py-2 px-3 d-none" role="status">
      <i class="fa fa-info-circle me-1" aria-hidden="true"></i>
      <span id="contrast-warning-text"></span>
    </div>
  </section>

  <!-- 6. Style Presets & Error Correction -->
  <section class="card p-3" aria-label="Style Presets">
    <div class="small fw-semibold text-white mb-2">
      <i class="fa fa-magic me-1 text-primary" aria-hidden="true"></i>
      Style Presets &amp; Error Correction
    </div>
    <div class="d-flex flex-wrap gap-2 mb-3">
      <button type="button" class="preset-btn active" data-preset="standard">Standard Crisp</button>
      <button type="button" class="preset-btn" data-preset="dots">Polka Dots</button>
      <button type="button" class="preset-btn" data-preset="fluid">Fluid Curves</button>
      <button type="button" class="preset-btn" data-preset="tech">Tech Rounded</button>
    </div>

    <div class="row g-3">
      <div class="col-12">
        <label for="opt-level" class="form-label small text-white mb-1">Error Correction Level</label>
        <select id="opt-level" class="form-select form-select-sm">
          <option value="L">Level L (7% Recovery)</option>
          <option value="M">Level M (15% Recovery)</option>
          <option value="Q">Level Q (25% Recovery)</option>
          <option value="H" selected>Level H (30% Recovery - Recommended)</option>
        </select>
        <small id="image-lock-notice" class="text-info d-block mt-1" style="font-size: 0.75rem;">
          <i class="fa fa-info-circle me-1"></i> Level H provides 30% error recovery, keeping the QR code
          readable even when images overlay modules.
        </small>
      </div>
    </div>
  </section>

</div>
